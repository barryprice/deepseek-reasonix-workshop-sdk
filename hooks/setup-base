#!/usr/bin/bash
set -euo pipefail

ln -sf "$SDK/usr/bin/reasonix" /usr/local/bin/reasonix
# Earlier revisions exported PATH here, which only login shells read; drop it on refresh.
rm -f /etc/profile.d/reasonix.sh

# Reasonix's default [sandbox] bash = "enforce" refuses all shell commands
# unless bubblewrap is available.
apt-get update
eatmydata apt-get install bubblewrap
